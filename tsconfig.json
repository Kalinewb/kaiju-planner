{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "strict": true, "noEmit": true, "skipLibCheck": true,
    "allowImportingTsExtensions": true, "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true, "types": ["node"], "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": ["server", "shared", "web/src", "test"]
}
